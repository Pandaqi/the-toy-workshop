; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Toy Workshop"
run/main_scene="uid://cgdjav32fnyi8"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="uid://c4qi4myoggsv2"

[autoload]

Global="*uid://cjblsc7fxuoqg"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://pq-obg/localization/obg.de.translation", "res://pq-obg/localization/obg.en.translation", "res://pq-obg/localization/obg.es.translation", "res://pq-obg/localization/obg.fr.translation", "res://pq-obg/localization/obg.it.translation", "res://pq-obg/localization/obg.nl.translation", "res://pq-obg/localization/obg.pt.translation", "res://the-toy-factory/localization/custom.de.translation", "res://the-toy-factory/localization/custom.en.translation", "res://the-toy-factory/localization/custom.es.translation", "res://the-toy-factory/localization/custom.fr.translation", "res://the-toy-factory/localization/custom.it.translation", "res://the-toy-factory/localization/custom.nl.translation", "res://the-toy-factory/localization/custom.pt.translation")

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
